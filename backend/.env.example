# Copy to `.env` and adjust as needed. The defaults below match docker-compose.yml,
# so for local dev you can use this file as-is.

# --- Database ---
# Host dev (API on host, Postgres in Docker): use localhost.
# Inside Docker (the `api` service), the host becomes `postgres` (the service name).
DATABASE_URL="postgresql://taskuser:taskpass@localhost:5433/task_tracker?schema=public"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6380

# --- Auth / JWT ---
# Use long random strings in any real environment. Access tokens are short-lived;
# refresh tokens are long-lived and rotated on every use (see auth module).
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_REFRESH_TTL="7d"

# --- App ---
PORT=3000

# Cache TTL (seconds) for the task-list cache. A short TTL is a safety net only;
# correctness comes from explicit invalidation on write (see redis module).
TASK_CACHE_TTL=60
